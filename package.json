{
  "name": "dailymoney",
  "version": "1.0.0",
  "description": "Website Quản lý Chi tiêu và Thu nhập Hàng ngày",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"npm --prefix client run dev\""
  },
  "keywords": ["finance", "expense-tracker", "daily-money", "vietnam"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
